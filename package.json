{
  "name": "heron-ai",
  "version": "0.4.0",
  "description": "Open-source agent interrogator — audit what your AI agents do, need, and access",
  "type": "module",
  "bin": {
    "heron": "./dist/bin/heron.js"
  },
  "scripts": {
    "dev": "next dev --port 3700 --hostname 127.0.0.1",
    "dev:cli": "tsx bin/heron.ts",
    "build": "next build && npm run build:standalone-assets && tsc -p tsconfig.cli.json",
    "build:standalone-assets": "node scripts/copy-standalone-assets.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "next build",
    "start": "next start --port 3700 --hostname 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.cli.json --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "audit",
    "security",
    "mcp",
    "interrogation",
    "access-control"
  ],
  "license": "MIT",
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE",
    "heron.example.yaml"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clack/prompts": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "clsx": "^2.1.1",
    "commander": "^12.0.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.39.0",
    "next": "^15.5.18",
    "openai": "^4.70.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.8.0",
    "vitest": "^2.0.0"
  }
}
