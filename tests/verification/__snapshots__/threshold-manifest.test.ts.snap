      "ReportVerificationStatus",
    ],
    "name": "verdict_pipeline_verificationFailedMapping",
    "rationale": "AAP-80: distinct from \`interrogation-only\` so the operator knows verification was attempted, not skipped. Caller opts in via \`options.surface2Attempted: true\`.",
    "sites": [
      {
        "file": "src/verification/verdict-pipeline.ts",
