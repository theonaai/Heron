    "value": "\`verdict.status === "unverified"\` AND no Surface 2 attempted → \`interrogation-only\`. Pre-scan baseline.",
  },
  "verdict_pipeline_partialMapping": {
    "affects": [
      "ReportVerificationStatus",
    ],
    "name": "verdict_pipeline_partialMapping",
    "rationale": "AAP-80: most common steady-state for AAP-79-era audits — discovery runs but OAuth introspection (AAP-64) is wired manually, so the verdict can almost never reach \`verified\`. The renderer needs a distinct label for this state vs interrogation-only.",
    "sites": [
      {
        "file": "src/verification/verdict-pipeline.ts",
