    ],
    "name": "verdict_pipeline_interrogationOnlyMapping",
    "rationale": "AAP-80: pre-scan reports must surface as "we interrogated but did not verify" so the reader knows the absence of Surface 2 is the diagnosis, not a failure. Defaults to this branch when the caller omits the \`surface2Attempted\` flag (conservative default).",
    "sites": [
      {
        "file": "src/verification/verdict-pipeline.ts",
